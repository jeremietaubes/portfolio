---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CaseStudyPage from "@/components/CaseStudyPage.astro";
import { getAllCaseStudies, getCaseStudyBySlug } from "@/lib/notion";
import { getContentById } from "@/utils/notion-id";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const caseStudies = await getAllCaseStudies();
  return caseStudies.map((cs) => ({
    params: { slug: cs.slug },
  }));
};

const { slug } = Astro.params;
const caseStudy = await getCaseStudyBySlug(slug!);

if (!caseStudy) {
  return Astro.redirect("/404");
}

// Image de partage differente de la cover du site, quand la cover ne fonctionne
// pas en petite vignette (reseaux sociaux, section Selection LinkedIn).
const SHARE_IMAGES: Record<string, string> = {
  // Design Sprint : le template plutot que la photo de l'equipe
  "35aabc1d446d80dd9c5ed52c89ba38ae": "/images/cacib-lead-cadrage-ux.webp",
};
const shareImage = SHARE_IMAGES[slug!] ?? caseStudy.coverImage;

const content = await getContentById(caseStudy.id);
const allCaseStudies = await getAllCaseStudies();
const currentIndex = allCaseStudies.findIndex((cs) => cs.slug === slug);
const prev = currentIndex > 0 ? allCaseStudies[currentIndex - 1] : undefined;
const next = currentIndex < allCaseStudies.length - 1 ? allCaseStudies[currentIndex + 1] : undefined;
---

<Layout
  title={`${caseStudy.title} — Jérémie Taubes`}
  description={caseStudy.summary}
  image={shareImage}
  ogType="article"
>
  <Header />
  <main>
    <CaseStudyPage
      caseStudy={caseStudy}
      content={content}
      prev={prev}
      next={next}
    />
  </main>
  <Footer />
</Layout>
