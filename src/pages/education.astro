---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import NotionContent from "@/components/NotionContent.astro";
import { getContentById, getPageTitle } from "@/utils/notion-id";

const PAGE_ID = "362abc1d446d8072b0efda3c0c747f8f";
const [title, content] = await Promise.all([getPageTitle(PAGE_ID), getContentById(PAGE_ID)]);
---

<Layout title="Education — Jérémie Taubes">
  <Header />
  <main class="px-10 pt-12 pb-18 min-h-screen">
    {title && (
      <div class="max-w-hero-inner mx-auto px-6 mb-10">
        <h1 class="font-display font-semibold text-display-sm md:text-display text-ink leading-h1">{title}</h1>
      </div>
    )}
    <div class="leading-prose">
      <NotionContent content={content} maxWidth="max-w-hero-inner" />
    </div>
    <div class="max-w-hero-inner mx-auto px-6 mt-10 pb-4 pt-8 border-t border-border-warm flex justify-end">
      <a href="/#work" class="inline-block bg-ink text-cream text-sm font-medium px-6 py-3 rounded-full hover:opacity-85 transition-opacity duration-150">
        Selected work →
      </a>
    </div>
  </main>
  <Footer />
</Layout>
