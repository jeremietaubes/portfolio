---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Page not found — Portfolio">
  <div class="max-w-3xl mx-auto px-6 py-32 text-center">
    <p class="text-sm font-medium text-ink-faint uppercase tracking-widest mb-4">404</p>
    <h1 class="text-4xl font-bold tracking-tight text-ink mb-4">Page not found</h1>
    <p class="text-lg text-ink-muted mb-10">This case study doesn't exist or has been removed.</p>
    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm font-medium text-ink hover:text-ink-muted transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
      </svg>
      Back to all case studies
    </a>
  </div>
</Layout>
