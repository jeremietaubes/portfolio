---
import { SHOW_CV, SHOW_LINKEDIN } from "@/config";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import NotionContent from "@/components/NotionContent.astro";
import { getContentById } from "@/utils/notion-id";
import type { ContentBlock } from "@/types/case-study";

const PAGE_ID = "362abc1d446d805d8a1ffd0cec67381f";
const content = await getContentById(PAGE_ID);

const cardIdx = content.findIndex((b: ContentBlock) => b.type === "card_group");
// Remonter jusqu'au heading qui précède le card_group pour l'exclure du hero
let splitIdx = cardIdx;
if (cardIdx > 0) {
  for (let i = cardIdx - 1; i >= 0; i--) {
    if (content[i].type === "heading" || content[i].type === "heading3") {
      splitIdx = i;
      break;
    }
    if (content[i].type !== "divider") break;
  }
}
const introContent: ContentBlock[] = splitIdx >= 0 ? content.slice(0, splitIdx) : content;
const restContent: ContentBlock[] = splitIdx >= 0 ? content.slice(splitIdx) : [];

// Chaque carte Notion devient une ligne : titre à gauche, liste à droite.
const rows = restContent
  .filter((b: ContentBlock) => b.type === "card_group")
  .flatMap((b: any) => b.items as string[])
  .map((html: string) => ({
    title: html.match(/<h3[^>]*>(?:<span[^>]*>.*?<\/span>)?(.*?)<\/h3>/s)?.[1]?.trim() ?? "",
    items: [...html.matchAll(/<li>(.*?)<\/li>/gs)].map((m) => m[1]),
  }));
---

<Layout title="About — Jérémie Taubes">
  <Header />
  <main class="bg-ink min-h-screen">

    <section class="max-w-hero-inner mx-auto px-6 md:px-10 pt-14 md:pt-[72px] pb-12 md:pb-16">
      <div class="flex flex-col md:flex-row items-center gap-8 md:gap-16">
        <img
          src="/images/workshop.webp"
          alt="Jérémie Taubes"
          class="shrink-0 w-[260px] h-[260px] md:w-[340px] md:h-[340px] rounded-full object-cover bg-cream/10"
        />
        <div class="leading-prose">
          {introContent.map((block) => {
            if (block.type === "paragraph") return <p class="font-reading text-base sm:text-[17px] leading-prose text-cream/85 mb-5" set:html={block.text} />;
            if (block.type === "heading") return <h1 class="font-display font-semibold text-display-sm text-cream mb-5 tracking-normal leading-h2">{block.text}</h1>;
            return null;
          })}
          <div class="flex flex-col sm:flex-row gap-3 mt-7 text-center sm:text-left">
            {SHOW_CV && (<a href="https://drive.google.com/file/d/1Bh6zpz4UUcL5fiZ34PNIHAu1Vf4_gJyw/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="inline-block border border-cream/40 text-cream text-[15px] leading-5 font-medium px-6 py-3 rounded-full hover:opacity-85 transition-opacity duration-150">Télécharger le CV<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline align-[-1px] ml-[5px]"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></a>)}
            {SHOW_LINKEDIN && (<a href="https://www.linkedin.com/in/jeremietaubes" target="_blank" rel="noopener noreferrer" class="inline-block border border-cream/40 text-cream text-[15px] leading-5 font-medium px-6 py-3 rounded-full hover:opacity-85 transition-opacity duration-150">Voir sur LinkedIn<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline align-[-1px] ml-[5px]"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg></a>)}
          </div>
        </div>
      </div>
    </section>

    <section class="max-w-hero-inner mx-auto px-6 md:px-10 pb-12">
      {rows.map((row) => (
        <div class="flex flex-col md:flex-row gap-4 md:gap-8 py-8 border-t border-cream/15">
          <h2 class="md:flex-1 font-sans font-semibold text-[20px] text-cream leading-[1.3] ![letter-spacing:-0.01em]" set:html={row.title} />
          <ul class="md:flex-1 flex flex-col gap-0.5">
            {row.items.map((item) => (
              <li class="flex items-start gap-3 text-base sm:text-[17px] leading-[1.4] text-cream/85">
                <span class="mt-[9px] w-1 h-1 rounded-full bg-ink-muted shrink-0"></span>
                <span class="font-reading" set:html={item} />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

  </main>
  <Footer dark />
</Layout>
