---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import NotionContent from "@/components/NotionContent.astro";
import { getContentById } from "@/utils/notion-id";

const PAGE_ID = "362abc1d446d8072b0efda3c0c747f8f";
const content = await getContentById(PAGE_ID);
---

<Layout title="Certifications — Jérémie Taubes">
  <Header />
  <main class="px-4 md:px-10 pt-8 md:pt-12 pb-12 md:pb-18 min-h-screen">
    <div class="leading-prose [&_h3+p]:!text-sm [&_h3+p]:!text-ink-muted [&_h3+p]:!leading-[1.4] [&_ul]:!space-y-0.5 [&_li]:!leading-[1.4]">
      <NotionContent content={content} maxWidth="max-w-hero-inner" firstHeadingAsH1 />
    </div>
    <div class="max-w-hero-inner mx-auto px-6 mt-10 pb-4 pt-8 border-t border-border-warm"></div>
  </main>
  <Footer />
</Layout>
