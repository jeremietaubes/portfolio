---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Footer from "@/components/Footer.astro";
import CaseStudyCard from "@/components/CaseStudyCard.astro";
import { getAllCaseStudies } from "@/lib/notion";

const caseStudies = await getAllCaseStudies();
---

<Layout title="Jérémie Taubes — Portfolio">
  <Header />
  <Hero />

  <section id="work" class="px-10 py-18">
    <div class="max-w-card-list mx-auto">

      <!-- Section label -->
      <div class="flex items-center gap-4 mb-10">
        <span class="text-xs uppercase tracking-wide-lg text-ink-muted whitespace-nowrap">
          Selected work
        </span>
        <div class="flex-1 h-px bg-border-warm"></div>
      </div>

      <!-- Cards container -->
      {caseStudies.length === 0 ? (
        <p class="text-sm text-ink-muted">Aucun projet publié pour le moment.</p>
      ) : (
        <div class="bg-card-bg border border-border-warm rounded-2xl overflow-hidden">
          {caseStudies.map((cs, i) => (
            <CaseStudyCard
              title={cs.title}
              description={cs.summary}
              category={cs.tags[0] ?? ''}
              year={cs.year}
              coverImage={cs.coverImage}
              slug={cs.slug}
              index={i}
            />
          ))}
        </div>
      )}
    </div>
  </section>

  <Footer />
</Layout>
