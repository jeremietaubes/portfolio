---
import Layout from "@/layouts/Layout.astro";
import CaseStudyCard from "@/components/CaseStudyCard.astro";
import { getAllCaseStudies } from "@/lib/notion";

const caseStudies = await getAllCaseStudies();
---

<Layout title="Portfolio — Case Studies">
  <section class="max-w-5xl mx-auto px-6 pt-20 pb-12">
    <div class="max-w-[556px]">
      <h1 class="text-4xl font-bold tracking-tight text-zinc-900 mb-4">
        Selected work
      </h1>
      <p class="text-lg text-zinc-500 leading-normal">
        UX & product design case studies — strategy, research, and execution across mobile, SaaS, and e-commerce.
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-24">
    {
      caseStudies.length === 0 ? (
        <p class="text-zinc-400 text-sm">No case studies published yet.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {caseStudies.map((cs) => (
            <CaseStudyCard caseStudy={cs} />
          ))}
        </div>
      )
    }
  </section>
</Layout>
