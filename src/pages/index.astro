---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Footer from "@/components/Footer.astro";
import CaseStudyCard from "@/components/CaseStudyCard.astro";
import { getAllCaseStudies } from "@/lib/notion";

const caseStudies = await getAllCaseStudies();
---

<Layout
  title="Jérémie Taubes — Senior AI Product Designer"
  description="Produits IA, outils métier B2B et transformation design, du MVP de start-up à la banque du CAC 40. 7 case studies."
  image="/images/cacib-ai-cover.webp"
>
  <Header />
  <Hero />

  <section id="work" class="px-4 md:px-10 pt-18 pb-12 md:pb-24" style="scroll-margin-top: 116px;">
    <div class="max-w-card-list mx-auto">

      <!-- Cards container -->
      {caseStudies.length === 0 ? (
        <p class="text-sm text-ink-muted">Aucun projet publié pour le moment.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {caseStudies.map((cs, i) => (
            <CaseStudyCard
              title={cs.title}
              description={cs.summary}
              tags={cs.tags}
              client={cs.client}
              year={cs.year}
              coverImage={cs.coverImage}
              slug={cs.slug}
              index={i}
              location={cs.location}
            />
          ))}
        </div>
      )}
    </div>
  </section>

  <Footer />
</Layout>
