---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const formations = [
  {
    diplome: "Master Design d'Expérience Utilisateur",
    ecole: "École de design Nantes Atlantique",
    annee: "2019",
  },
  {
    diplome: "Bachelor Communication Visuelle",
    ecole: "LISAA Paris",
    annee: "2017",
  },
  {
    diplome: "Certificat UX Research",
    ecole: "Nielsen Norman Group",
    annee: "2021",
  },
];
---

<Layout title="Formation — Jérémie Taubes">
  <Header />
  <main class="px-10 pt-12 pb-18 min-h-screen">
    <div class="max-w-hero-inner mx-auto">

      <p class="text-xs uppercase tracking-wide-lg text-ink-muted mb-12">Formation</p>

      <div class="space-y-0">
        {formations.map((f, i) => (
          <div class="py-10 flex flex-col md:flex-row md:items-start gap-2 md:gap-12">
            <div class="md:w-48 shrink-0">
              <p class="text-xs text-ink-muted">{f.annee}</p>
            </div>
            <div>
              <h2 class="font-display text-section-h text-ink mb-1">{f.diplome}</h2>
              <p class="text-sm text-ink-muted">{f.ecole}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </main>
  <Footer />
</Layout>
