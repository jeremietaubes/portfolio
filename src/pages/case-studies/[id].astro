---
import Layout from "@/layouts/Layout.astro";
import { getAllCaseStudies } from "@/lib/notion";
import { getContentById } from "@/utils/notion-id";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const caseStudies = await getAllCaseStudies();
  return caseStudies.map((cs) => ({
    params: { id: cs.id },
    props: { caseStudy: cs },
  }));
};

const { id } = Astro.params;
const { caseStudy } = Astro.props;

if (!caseStudy) {
  return Astro.redirect("/404");
}

const content = await getContentById(id!);
const allCaseStudies = await getAllCaseStudies();
const currentIndex = allCaseStudies.findIndex((cs) => cs.id === id);
const prev = currentIndex > 0 ? allCaseStudies[currentIndex - 1] : undefined;
const next = currentIndex < allCaseStudies.length - 1 ? allCaseStudies[currentIndex + 1] : undefined;
---

<Layout title={`${caseStudy.title} — Portfolio`} description={caseStudy.summary}>
  <!-- Back link -->
  <div class="max-w-content mx-auto px-6 pt-10">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-sm text-ink-muted hover:text-ink transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
      </svg>
      All case studies
    </a>
  </div>

  <!-- Hero -->
  <header class="max-w-content mx-auto px-6 pt-10 pb-12">
    <div class="flex items-center gap-2 flex-wrap mb-5">
      {caseStudy.tags.map((tag) => (
        <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-border-light text-ink">
          {tag}
        </span>
      ))}
    </div>

    <h1 class="text-4xl font-bold tracking-tight text-ink mb-4">
      {caseStudy.title}
    </h1>

    <p class="text-xl text-ink-muted leading-normal">
      {caseStudy.summary}
    </p>

    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 pt-8 border-t border-border-light">
      <div>
        <dt class="text-xs font-medium text-ink-faint uppercase tracking-wider mb-1">Client</dt>
        <dd class="text-sm font-semibold text-ink">{caseStudy.client}</dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-ink-faint uppercase tracking-wider mb-1">Year</dt>
        <dd class="text-sm font-semibold text-ink">{caseStudy.year}</dd>
      </div>
    </div>
  </header>

  <!-- Cover image -->
  {caseStudy.coverImage && (
    <div class="max-w-5xl mx-auto px-6 mb-16">
      <img
        src={caseStudy.coverImage}
        alt={caseStudy.title}
        class="w-full rounded-2xl aspect-video object-cover bg-cream"
      />
    </div>
  )}

  <!-- Rich content blocks -->
  {content.length > 0 && (
    <article class="max-w-content mx-auto px-6 mb-24 space-y-6">
      {content.map((block) => {
        if (block.type === "heading") {
          return (
            <h2 class="text-2xl md:text-display-sm font-bold text-ink">{block.text}</h2>
          );
        }
        if (block.type === "subtitle") {
          return (
            <p class="text-xs font-semibold text-ink-faint uppercase tracking-wider -mb-3">{block.text}</p>
          );
        }
        if (block.type === "paragraph") {
          return (
            <p class="text-base text-ink leading-normal" set:html={block.text} />
          );
        }
        if (block.type === "quote") {
          return (
            <blockquote class="border-l-4 border-ink pl-5 italic text-ink-soft text-lg">
              {block.text}
            </blockquote>
          );
        }
        if (block.type === "bullet_list") {
          return (
            <ul class="space-y-2 pl-1">
              {block.items.map((item) => (
                <li class="flex items-start gap-2.5 text-base text-ink leading-normal">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink-faint" />
                  <span set:html={item} />
                </li>
              ))}
            </ul>
          );
        }
        if (block.type === "numbered_list") {
          return (
            <ol class="space-y-2 pl-1 list-none">
              {block.items.map((item, i) => (
                <li class="flex items-start gap-2.5 text-base text-ink leading-normal">
                  <span class="shrink-0 font-semibold text-ink-faint tabular-nums">{i + 1}.</span>
                  <span set:html={item} />
                </li>
              ))}
            </ol>
          );
        }
        if (block.type === "image") {
          return (
            <figure>
              <img
                src={block.url}
                alt={block.alt ?? ""}
                class="w-full rounded-xl bg-cream"
                loading="lazy"
              />
              {block.alt && (
                <figcaption class="mt-2 text-center text-xs text-ink-faint">
                  {block.alt}
                </figcaption>
              )}
            </figure>
          );
        }
      })}
    </article>
  )}

  <!-- Bottom navigation -->
  {(prev || next) && (
    <div class="max-w-content mx-auto px-6 mb-16 pt-8 border-t border-border-light flex justify-between">
      {prev ? (
        <a href={`/case-studies/${prev.id}`} class="text-sm text-ink-muted hover:text-ink transition-colors">
          ← {prev.title}
        </a>
      ) : <span />}
      {next ? (
        <a href={`/case-studies/${next.id}`} class="text-sm text-ink-muted hover:text-ink transition-colors">
          {next.title} →
        </a>
      ) : <span />}
    </div>
  )}
</Layout>
