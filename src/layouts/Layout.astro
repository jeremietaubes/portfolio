---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Jérémie Taubes — Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="fr" style="scroll-behavior: smooth;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Inter:wght@300;400;500;700&family=Nunito:wght@800;900&family=Poppins:wght@400;500;600;700;800;900&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-cream text-ink font-sans antialiased">
    <slot />
  </body>
  <style is:global>
    .font-display {
      letter-spacing: -0.015em;
    }

    .font-reading {
      letter-spacing: -0.001em;
    }

    @keyframes fade-up {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    header {
      animation: fade-up 0.35s ease both;
    }

    main {
      animation: fade-up 0.4s ease both;
      animation-delay: 0.05s;
    }

    /* Hero elements */
    .hero-photo {
      animation: fade-up 0.45s ease both;
      animation-delay: 0.1s;
    }

    section h1 {
      animation: fade-up 0.45s ease both;
      animation-delay: 0.15s;
    }

    section p {
      animation: fade-up 0.45s ease both;
      animation-delay: 0.2s;
    }

    /* Cards staggered */
    .card-link:nth-child(1) { animation: fade-up 0.45s ease both; animation-delay: 0.15s; }
    .card-link:nth-child(2) { animation: fade-up 0.45s ease both; animation-delay: 0.22s; }
    .card-link:nth-child(3) { animation: fade-up 0.45s ease both; animation-delay: 0.29s; }
    .card-link:nth-child(4) { animation: fade-up 0.45s ease both; animation-delay: 0.36s; }

    /* Inner page content */
    main h1 {
      animation: fade-up 0.45s ease both;
      animation-delay: 0.1s;
    }

    main h2 {
      animation: fade-up 0.4s ease both;
      animation-delay: 0.12s;
    }
  </style>
</html>
