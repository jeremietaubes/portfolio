---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portfolio — Case Studies" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-white text-zinc-900 font-sans antialiased">
    <header class="border-b border-zinc-100">
      <div class="max-w-5xl mx-auto px-6 py-5 flex items-center justify-between">
        <a href="/" class="text-base font-semibold tracking-tight hover:text-zinc-600 transition-colors">
          Portfolio
        </a>
        <nav class="flex gap-6 text-sm text-zinc-500">
          <a href="/" class="hover:text-zinc-900 transition-colors">Work</a>
          <a href="#contact" class="hover:text-zinc-900 transition-colors">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-zinc-100 mt-24">
      <div class="max-w-5xl mx-auto px-6 py-8 text-sm text-zinc-400">
        © {new Date().getFullYear()} — All rights reserved
      </div>
    </footer>
  </body>
</html>
