---
import type { CaseStudy, ContentBlock } from "@/types/case-study";

interface Props {
  caseStudy: CaseStudy;
  content: ContentBlock[];
  prev?: CaseStudy;
  next?: CaseStudy;
}

const { caseStudy, content, prev, next } = Astro.props;

---

<!-- Back link -->
<div class="max-w-article mx-auto px-6 pt-5 md:pt-10">
  <a
    href="/"
    class="inline-flex items-center gap-2 text-sm font-medium bg-ink text-cream px-5 py-2.5 rounded-full hover:opacity-85 transition-opacity duration-150"
  >
    ← Back
  </a>
</div>

<!-- Title + summary + tags -->
<header class="max-w-article mx-auto px-6 pt-4 pb-8 md:pt-8">
  <h1 class="font-display font-semibold text-display-sm md:text-display text-ink mb-4 leading-h1">
    {caseStudy.title}
  </h1>
  {caseStudy.summary && (
    <p class="font-reading text-base sm:text-xl leading-prose text-ink-soft mb-4" set:html={caseStudy.summary} />
  )}
  {caseStudy.tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-5">
      {caseStudy.tags.map((tag) => (
        <span class="inline-block px-2.5 py-0.5 rounded-full border border-border-warm text-ink-soft text-sm font-medium">{tag}</span>
      ))}
    </div>
  )}
  <div class="border-t border-border-warm mt-6 pt-6 flex flex-wrap justify-between gap-4">
    {caseStudy.client && (
      <div class="flex items-center gap-3">
        <div class="meta-icon" style="background:#F0EEE8; color:#141413;">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 15V3h12v12"/><line x1="1" y1="15" x2="15" y2="15"/><path d="M6 15v-4h4v4"/>
          </svg>
        </div>
        <p class="text-sm text-ink">{caseStudy.client}</p>
      </div>
    )}
    <div class="flex items-center gap-3">
      <div class="meta-icon" style="background:#F0EEE8; color:#141413;">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="3" width="12" height="11" rx="1.5"/><line x1="5" y1="1.5" x2="5" y2="4.5"/><line x1="11" y1="1.5" x2="11" y2="4.5"/><line x1="2" y1="7" x2="14" y2="7"/>
        </svg>
      </div>
      <p class="text-sm text-ink">{caseStudy.year}</p>
    </div>
    {caseStudy.location && (
      <div class="flex items-center gap-3">
        <div class="meta-icon" style="background:#F0EEE8; color:#141413;">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 1.5A4.5 4.5 0 0 1 12.5 6c0 3-4.5 8.5-4.5 8.5S3.5 9 3.5 6A4.5 4.5 0 0 1 8 1.5z"/><circle cx="8" cy="6" r="1.5"/>
          </svg>
        </div>
        <p class="text-sm text-ink">{caseStudy.location}</p>
      </div>
    )}
  </div>
</header>

<!-- Cover image -->
{caseStudy.coverImage ? (
  <div class="px-0 md:px-6 max-w-5xl mx-auto">
    <img
      src={caseStudy.coverImage}
      alt={caseStudy.title}
      class="w-full object-cover rounded-none md:rounded-2xl bg-border-light max-h-cover zoomable-image"
    />
  </div>
) : (
  <div class="px-6 max-w-5xl mx-auto">
    <div class="w-full rounded-2xl bg-border-light h-placeholder"></div>
  </div>
)}

<!-- Rich content -->
{content.length > 0 && (
  <div class="pt-4 pb-12 md:pt-6 md:pb-24 leading-prose">
    {content.map((block) => {
      if (block.type === 'image') {
        return (
          <div class="px-0 md:px-6 max-w-5xl mx-auto mb-6 mt-6 md:mb-14 md:mt-14">
            <img
              src={block.url}
              alt=""
              class="w-full object-cover rounded-none md:rounded-2xl bg-border-light ring-0 md:ring-1 md:ring-border-light max-h-block-image zoomable-image"
              loading="lazy"
            />
          </div>
        );
      }
      if (block.type === 'heading') {
        return (
          <div class="max-w-prose-body mx-auto px-6 mb-6">
            <h2 class="font-display font-semibold text-section-h md:text-display-sm text-ink mt-6 mb-0 tracking-normal leading-h2">{block.text}</h2>
          </div>
        );
      }
      if (block.type === 'heading3') {
        return (
          <div class="max-w-prose-body mx-auto px-6 mb-4">
            <h3 class="font-display font-semibold text-[20px] text-ink mt-4 mb-0 leading-h2 ![letter-spacing:0em]">{block.text}</h3>
          </div>
        );
      }
      if (block.type === 'band') {
        return (
          <div class="max-w-prose-body mx-auto px-6 mt-7 mb-7 sm:mt-11 sm:mb-11">
            <div class="border-[5px] border-[#F0EEE8] rounded-2xl px-5 py-5 sm:px-10 sm:py-8">
              <p class="font-reading text-base sm:text-xl leading-prose text-ink-muted" set:html={block.text} />
            </div>
          </div>
        );
      }
      if (block.type === 'subtitle') {
        return (
          <div class="max-w-prose-body mx-auto px-6 mt-8 -mb-1">
            <p class="pl-4 border-l border-border-warm text-base font-sans text-ink-muted font-normal py-2">{block.text}</p>
          </div>
        );
      }
      if (block.type === 'numbered_item') {
        return (
          <div class="max-w-prose-body mx-auto px-6 mb-2">
            <p class="numbered-item">
              <span class="num-badge">{block.num}</span>
              <span class="font-reading" set:html={block.text} />
            </p>
          </div>
        );
      }
      if (block.type === 'paragraph') {
        return (
          <div class="max-w-prose-body mx-auto px-6 mb-6">
            <p class="font-reading text-base sm:text-xl leading-prose text-ink-soft" set:html={block.text} />
          </div>
        );
      }
      if (block.type === 'quote') {
        return (
          <div class="max-w-prose-body mx-auto px-6 mb-8">
            <blockquote class="border-l-2 border-ink-muted pl-5 text-ink-soft font-reading text-base sm:text-xl leading-prose" set:html={block.text} />
          </div>
        );
      }
      if (block.type === 'bullet_list') {
        return (
          <div class="max-w-prose-body mx-auto px-6 mb-8">
            <ul class="space-y-2 pl-1">
              {block.items.map((item) => (
                <li class="flex items-start gap-3 text-base sm:text-xl text-ink-soft">
                  <span class="mt-2.5 w-1 h-1 rounded-full bg-ink-faint shrink-0"></span>
                  <span class="font-reading" set:html={item} />
                </li>
              ))}
            </ul>
          </div>
        );
      }
      if (block.type === 'callout') {
        return (
          <div class="max-w-prose-body mx-auto px-6 mb-8">
            <div class="bg-white ring-1 ring-border-warm shadow-md rounded-2xl px-5 md:px-10 pt-5 pb-6 sm:py-8 flex flex-col sm:flex-row gap-3 sm:gap-4 items-start">
              <div class="callout-icon shrink-0 sm:mt-1">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="10" cy="10" r="8.5"/><circle cx="10" cy="10" r="5"/><circle cx="10" cy="10" r="2" fill="currentColor" stroke="none"/>
                </svg>
              </div>
              <p class="font-reading text-base sm:text-xl leading-prose text-ink-soft" set:html={block.text} />
            </div>
          </div>
        );
      }
      if (block.type === 'numbered_list') {
        return (
          <div class="max-w-prose-body mx-auto px-6 mb-8">
            <ol class="space-y-2 pl-1 list-none">
              {block.items.map((item, i) => (
                <li class="flex items-start gap-3 text-base sm:text-xl text-ink-soft">
                  <span class="shrink-0 font-medium text-ink-faint tabular-nums">{i + 1}.</span>
                  <span class="font-reading" set:html={item} />
                </li>
              ))}
            </ol>
          </div>
        );
      }
    })}
  </div>
)}

<style>
  .callout-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #F0EEE8;
    color: #141413;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .callout-icon svg {
    width: 18px;
    height: 18px;
  }
  .meta-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .meta-icon svg {
    width: 16px;
    height: 16px;
  }
  .numbered-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin: 8px 0;
    margin-left: -16px;
    font-size: 20px;
    color: #3D3D3A;
    line-height: 1.65;
  }
  :global(.sub-list) {
    list-style: none;
    margin-top: 6px;
    padding-left: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  :global(.sub-list li) {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  :global(.sub-list li)::before {
    content: "";
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #C0BFBA;
    flex-shrink: 0;
    margin-top: 10px;
  }
  :global(.callout-list) {
    list-style: none;
    margin: 0;
    padding-left: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  :global(.callout-list li) {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 1rem;
    color: #3D3D3A;
  }
  :global(.callout-list li)::before {
    content: "";
    display: block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #C0BFBA;
    flex-shrink: 0;
    margin-top: 10px;
  }
  .num-badge {
    min-width: 24px;
    height: 24px;
    background: #141413;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 500;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }
</style>

<dialog id="img-lightbox">
  <img id="img-lightbox-src" src="" alt="" />
</dialog>

<style>
  #img-lightbox {
    margin: 0;
    padding: 0;
    border: none;
    background: #141413;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
  }
  #img-lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #img-lightbox-src {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    touch-action: pinch-zoom;
  }
</style>

<script>
  const dialog = document.getElementById('img-lightbox') as HTMLDialogElement;
  const dialogImg = document.getElementById('img-lightbox-src') as HTMLImageElement;

  document.querySelectorAll('.zoomable-image').forEach((img) => {
    (img as HTMLElement).style.cursor = 'zoom-in';
    img.addEventListener('click', () => {
      dialogImg.src = (img as HTMLImageElement).src;
      dialogImg.alt = (img as HTMLImageElement).alt;
      dialog.showModal();
    });
  });

  dialog.addEventListener('click', () => dialog.close());
</script>

<!-- Bottom navigation -->
{(prev || next) && (
  <div class="max-w-card-list mx-auto px-6 mb-12 md:mb-16 pt-8 border-t border-border-warm flex flex-col sm:flex-row sm:justify-between gap-4">
    {prev ? (
      <a href={`/case/${prev.slug}`} title={prev.title} class="sm:flex-1 min-w-0 inline-flex items-center gap-2 text-sm font-medium bg-ink text-cream px-5 py-2.5 rounded-full hover:opacity-85 transition-opacity duration-150 overflow-hidden">
        <span class="shrink-0">←</span><span class="truncate">{prev.title}</span>
      </a>
    ) : <span class="sm:flex-1" />}
    {next ? (
      <a href={`/case/${next.slug}`} title={next.title} class="sm:flex-1 min-w-0 inline-flex items-center sm:justify-end gap-2 text-sm font-medium bg-ink text-cream px-5 py-2.5 rounded-full hover:opacity-85 transition-opacity duration-150 overflow-hidden">
        <span class="truncate sm:text-right">{next.title}</span><span class="shrink-0">→</span>
      </a>
    ) : <span class="sm:flex-1" />}
  </div>
)}
