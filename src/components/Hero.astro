---
---

<section class="min-h-hero bg-cream flex flex-col items-center justify-center px-10 py-20 gap-10">
  <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12 w-full max-w-hero-inner">

    <div class="shrink-0">
      <img
        src="/images/photo.webp"
        alt="Jérémie Taubes"
        class="hero-photo rounded-full object-cover bg-border-warm"
        onerror="this.style.display='none';document.getElementById('photo-fallback').style.display='block';"
      />
      <div id="photo-fallback" class="hero-photo rounded-xl bg-border-warm hidden"></div>
    </div>

    <div>
      <p class="pl-4 border-l border-border-warm text-sm font-sans text-ink-muted font-normal py-2 mb-4">Lead Product Designer</p>
      <h1 class="font-display font-semibold leading-tight text-ink mb-4.5 text-display md:text-display-xl">
        J'accompagne les entreprises et les designers dans la création de produits à fort impact.
      </h1>
      <p class="font-reading text-xl leading-prose text-ink-soft mb-8">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco.
      </p>
      <div class="flex gap-3">
        <a href="https://drive.google.com/file/d/1CQmfQsRKS4hd-aNF8bl6r1GaOeidruFC/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="inline-block border border-border-warm text-ink text-sm font-medium px-6 py-3 rounded-full hover:opacity-85 transition-opacity duration-150">Télécharger le CV<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline align-[-1px] ml-[5px]"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></a>
        <button
          id="hero-cta"
          class="bg-ink text-cream text-sm font-medium px-6 py-3 rounded-full hover:opacity-85 transition-opacity duration-150"
        >
          Selected work ↓
        </button>
      </div>
    </div>

  </div>
</section>

<style>
  .hero-photo {
    width: 260px;
    height: 260px;
  }
</style>

<script>
  document.getElementById('hero-cta')?.addEventListener('click', () => {
    document.getElementById('work')?.scrollIntoView({ behavior: 'smooth' });
  });
</script>
