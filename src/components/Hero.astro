---
---

<section class="min-h-hero bg-cream flex flex-col items-center justify-center px-4 md:px-10 pt-7 pb-12 md:py-20 gap-10">
  <div class="flex flex-col md:flex-row items-center gap-8 md:gap-20 w-full max-w-[1160px]">

    <div class="shrink-0">
      <img
        src="/images/photo.webp"
        alt="Jérémie Taubes"
        class="hero-photo rounded-full object-cover bg-border-warm"
        onerror="this.style.display='none';document.getElementById('photo-fallback').style.display='block';"
      />
      <div id="photo-fallback" class="hero-photo rounded-xl bg-border-warm hidden"></div>
    </div>

    <div>
      <div class="flex flex-wrap gap-2 sm:gap-8 mb-5">
        <div class="flex items-center gap-2" >
          <div class="hero-skill-icon" style="background:#D6EAD2; color:#141413;">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="5" r="2.5"/><circle cx="3" cy="12" r="2"/><circle cx="13" cy="12" r="2"/><line x1="8" y1="7.5" x2="3" y2="10"/><line x1="8" y1="7.5" x2="13" y2="10"/></svg>
          </div>
          <span class="text-sm md:text-base font-display font-normal text-ink">Leadership</span>
        </div>
        <div class="flex items-center gap-2" >
          <div class="hero-skill-icon" style="background:#E4D4EE; color:#141413;">
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="8.5"/><circle cx="10" cy="10" r="5"/><circle cx="10" cy="10" r="2" fill="currentColor" stroke="none"/></svg>
          </div>
          <span class="text-sm md:text-base font-display font-normal text-ink">Stratégie</span>
        </div>
        <div class="flex items-center gap-2" >
          <div class="hero-skill-icon" style="background:#D4E2EC; color:#141413;">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4,4 4,12 12,12"/><circle cx="4" cy="4" r="1.5" fill="currentColor" stroke="none"/><circle cx="4" cy="12" r="1.5" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/></svg>
          </div>
          <span class="text-sm md:text-base font-display font-normal text-ink">Craft</span>
        </div>
      </div>
      <h1 class="font-display font-semibold leading-tight text-ink mb-4.5 text-3xl md:text-display md:text-display-xl">
        Je conçois des produits à fort impact avec des designers que j'accompagne au quotidien.
      </h1>
      <p class="font-reading text-base md:text-xl leading-prose text-ink-soft mb-8">
        15 ans d'expérience, du MVP startup aux outils métier complexes (Finance, CRM, SaaS, IA), je combine Data, UX Research, prototypage rapide et co-création pour construire des produits qui tiennent leurs promesses.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 text-center sm:text-left">
        <a href="https://drive.google.com/file/d/1CQmfQsRKS4hd-aNF8bl6r1GaOeidruFC/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="inline-block border border-border-warm text-ink text-sm font-medium px-6 py-3 rounded-full hover:opacity-85 transition-opacity duration-150">Télécharger le CV<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline align-[-1px] ml-[5px]"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></a>
        <button
          id="hero-cta"
          class="bg-ink text-cream text-sm font-medium px-6 py-3 rounded-full hover:opacity-85 transition-opacity duration-150"
        >
          Selected work ↓
        </button>
      </div>
    </div>

  </div>
</section>

<style>
  .hero-skill-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .hero-skill-icon svg {
    width: 20px;
    height: 20px;
  }
  .hero-photo {
    width: 180px;
    height: 180px;
  }
  @media (min-width: 768px) {
    .hero-photo {
      width: 280px;
      height: 280px;
    }
  }
</style>

<script>
  document.getElementById('hero-cta')?.addEventListener('click', () => {
    document.getElementById('work')?.scrollIntoView({ behavior: 'smooth' });
  });
</script>
