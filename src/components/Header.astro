---
---

<header class="sticky top-0 z-50 bg-cream border-b border-border-warm">
  <div class="flex items-center justify-between px-10 py-4.5">
    <a href="/" class="nav-link font-medium text-ink" style="font-size:14px;">Jérémie Taubes - Portfolio</a>

    <nav class="hidden md:flex items-center gap-1">
      <a href="/#work" class="nav-link">Work</a>
      <a href="/experience" class="nav-link">Expériences</a>
      <a href="/formations" class="nav-link">Formation</a>
      <a href="/about" class="nav-link">About</a>
      <a href="#contact" class="nav-link">Contact</a>
    </nav>

    <button id="menu-toggle" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Ouvrir le menu">
      <span id="bar1" class="block w-5 bg-ink" style="height:1px;transition:transform .15s ease,opacity .15s ease;"></span>
      <span id="bar2" class="block w-5 bg-ink" style="height:1px;transition:opacity .15s ease;"></span>
      <span id="bar3" class="block w-5 bg-ink" style="height:1px;transition:transform .15s ease;"></span>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-border-warm bg-cream">
    <nav class="flex flex-col px-10 py-6 gap-5">
      <a href="/#work" class="text-sm text-ink-muted hover:text-ink transition-colors duration-150">Work</a>
      <a href="/experience" class="text-sm text-ink-muted hover:text-ink transition-colors duration-150">Expériences</a>
      <a href="/formations" class="text-sm text-ink-muted hover:text-ink transition-colors duration-150">Formation</a>
      <a href="/about" class="text-sm text-ink-muted hover:text-ink transition-colors duration-150">About</a>
      <a href="#contact" class="text-sm text-ink-muted hover:text-ink transition-colors duration-150">Contact</a>
    </nav>
  </div>
</header>

<style>
  .nav-link {
    font-size: 13px;
    color: #6B6B6B;
    padding: 6px 12px;
    border-radius: 20px;
    border: 1px solid transparent;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .nav-link:hover,
  .nav-link.active {
    background: #F0EFED;
    border-color: #E2E0DC;
    color: #1A1A16;
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu   = document.getElementById('mobile-menu');
  const bar1   = document.getElementById('bar1');
  const bar2   = document.getElementById('bar2');
  const bar3   = document.getElementById('bar3');
  let open = false;

  toggle?.addEventListener('click', () => {
    open = !open;
    menu?.classList.toggle('hidden', !open);
    if (bar1 && bar2 && bar3) {
      if (open) {
        bar1.style.transform = 'translateY(6px) rotate(45deg)';
        bar2.style.opacity   = '0';
        bar3.style.transform = 'translateY(-6px) rotate(-45deg)';
      } else {
        bar1.style.transform = '';
        bar2.style.opacity   = '';
        bar3.style.transform = '';
      }
    }
  });

  const links = document.querySelectorAll('nav a');
  links.forEach(link => {
    if (link.getAttribute('href') === window.location.pathname) {
      link.classList.add('active');
    }
  });

  document.querySelectorAll('nav a[href="/#work"]').forEach(link => {
    link.addEventListener('click', (e) => {
      const work = document.getElementById('work');
      if (work) {
        e.preventDefault();
        work.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
</script>
