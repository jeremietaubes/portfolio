---
---

<header class="sticky top-0 z-50 bg-cream border-b border-border-warm">
  <div class="flex items-center justify-between px-4 md:px-10 py-4">
    <a href="/" class="flex items-center gap-3 font-display font-semibold text-[15px] text-ink">
      <span class="jt-logo">JT</span>
      <span class="flex flex-col md:flex-row md:gap-0">
        <span>Jérémie Taubes</span>
        <span class="hidden md:inline">&nbsp;-&nbsp;</span>
        <span class="whitespace-nowrap">Lead Product Designer</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-1">
      <a href="/#work" class="nav-link">Work</a>
      <a href="/about" class="nav-link">About</a>
      <a href="/certifications" class="nav-link">Certifications</a>
      <a href="https://www.linkedin.com/in/jeremie-taubes" target="_blank" rel="noopener noreferrer" class="nav-link">LinkedIn</a>
      <a href="mailto:jeremie.taubes@gmail.com" class="nav-link-btn">
        Contact
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline align-[-1px] ml-[5px]"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </a>
    </nav>

    <button id="menu-toggle" class="lg:hidden flex flex-col gap-1.5 p-2" aria-label="Ouvrir le menu">
      <span id="bar1" class="block w-5 h-px bg-ink transition-[transform,opacity] duration-150 ease-in-out"></span>
      <span id="bar2" class="block w-5 h-px bg-ink transition-opacity duration-150 ease-in-out"></span>
      <span id="bar3" class="block w-5 h-px bg-ink transition-transform duration-150 ease-in-out"></span>
    </button>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-border-warm bg-cream">
    <nav class="flex flex-col px-4 md:px-10 py-6 gap-5">
      <a href="/#work" class="text-sm text-ink-muted hover:text-ink transition-colors duration-150 pl-4">Work</a>
      <a href="/about" class="text-sm text-ink-muted hover:text-ink transition-colors duration-150 pl-4">About</a>
      <a href="/certifications" class="text-sm text-ink-muted hover:text-ink transition-colors duration-150 pl-4">Certifications</a>
      <a href="https://www.linkedin.com/in/jeremie-taubes" target="_blank" rel="noopener noreferrer" class="text-sm text-ink-muted hover:text-ink transition-colors duration-150 pl-4">LinkedIn</a>
      <a href="mailto:jeremie.taubes@gmail.com" class="nav-link-btn-mobile">
        Contact
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline align-[-1px] ml-[5px]"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </a>

    </nav>
  </div>
</header>

<style>
  @keyframes logo-colors {
    0%   { background: #C45C7A; border-radius: 72% 28% 38% 62% / 40% 55% 45% 60%; }
    17%  { background: #B8572A; border-radius: 45% 55% 65% 35% / 55% 40% 60% 45%; }
    34%  { background: #141413; border-radius: 60% 40% 50% 50% / 35% 65% 35% 65%; }
    50%  { background: #4A90B8; border-radius: 55% 45% 40% 60% / 50% 60% 40% 50%; }
    67%  { background: #6B2D4E; border-radius: 35% 65% 30% 70% / 60% 45% 55% 40%; }
    84%  { background: #1E5A6A; border-radius: 50% 50% 45% 55% / 45% 55% 50% 50%; }
    100% { background: #C45C7A; border-radius: 72% 28% 38% 62% / 40% 55% 45% 60%; }
  }
  .jt-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 72% 28% 38% 62% / 40% 55% 45% 60%;
    animation: logo-colors 20s ease-in-out infinite;
    color: #FAFAF7;
    font-family: 'Fredoka', sans-serif;
    font-weight: 700;
    font-size: 16px;
    letter-spacing: 0.03em;
    flex-shrink: 0;
  }
  .nav-link {
    font-size: 14px;
    color: #6B6B6B;
    padding: 6px 12px;
    border-radius: 20px;
    border: 1px solid transparent;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .nav-link:hover,
  .nav-link.active {
    background: #F7F5F0;
    border-color: #E0DED6;
    color: #141413;
  }
  .nav-link-btn {
    font-size: 13px;
    color: #FAFAF7;
    background: #141413;
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid #141413;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .nav-link-btn:hover {
    background: #3D3D3A;
    border-color: #3D3D3A;
  }
  .nav-link-btn-mobile {
    font-size: 14px;
    color: #FAFAF7;
    background: #141413;
    padding: 8px 16px;
    border-radius: 20px;
    border: 1px solid #141413;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    transition: background 0.15s, border-color 0.15s;
  }
  .nav-link-btn-mobile:hover {
    background: #3D3D3A;
    border-color: #3D3D3A;
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu   = document.getElementById('mobile-menu');
  const bar1   = document.getElementById('bar1');
  const bar2   = document.getElementById('bar2');
  const bar3   = document.getElementById('bar3');
  let open = false;

  toggle?.addEventListener('click', () => {
    open = !open;
    menu?.classList.toggle('hidden', !open);
    if (bar1 && bar2 && bar3) {
      if (open) {
        bar1.style.transform = 'translateY(6px) rotate(45deg)';
        bar2.style.opacity   = '0';
        bar3.style.transform = 'translateY(-6px) rotate(-45deg)';
      } else {
        bar1.style.transform = '';
        bar2.style.opacity   = '';
        bar3.style.transform = '';
      }
    }
  });

  const links = document.querySelectorAll('nav a.nav-link');
  links.forEach(link => {
    if (link.getAttribute('href') === window.location.pathname) {
      link.classList.add('active');
    }
  });

  document.querySelectorAll('nav a[href="/#work"]').forEach(link => {
    link.addEventListener('click', (e) => {
      const work = document.getElementById('work');
      if (work) {
        e.preventDefault();
        work.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
</script>
