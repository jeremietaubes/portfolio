---
interface Props {
  title: string;
  description: string;
  category: string;
  year: number;
  coverImage: string;
  slug: string;
  index: number;
}

const { title, description, category, year, coverImage, slug, index } = Astro.props;

const indexLabel = String(index + 1).padStart(2, '0');
---

<a
  href={`/case/${slug}`}
  class="card-link group flex border-b border-border-light last:border-b-0 hover:bg-hover-warm transition-colors duration-150"
>
  <!-- Left column -->
  <div class="left-col shrink-0 border-r border-border-light flex flex-col justify-between">
    <div>
      <div class="text-xs font-medium text-ink-faint mb-3">{indexLabel}</div>
      {category && (
        <span class="inline-block text-xs uppercase tracking-wide-sm text-ink-muted border border-border-warm rounded-full px-2 py-0.5">
          {category}
        </span>
      )}
    </div>
    <div class="text-xs text-ink-faint">{year}</div>
  </div>

  <!-- Right column -->
  <div class="flex-1 flex items-center gap-6 p-7">
    <div class="flex-1 min-w-0">
      <h2 class="text-lg font-medium tracking-tight-lg text-ink mb-1.5">{title}</h2>
      <p class="text-sm text-ink-muted leading-relaxed max-w-sm">{description}</p>
    </div>

    {coverImage ? (
      <img
        src={coverImage}
        alt={title}
        class="thumb rounded-lg object-cover shrink-0 bg-border-light"
        loading="lazy"
      />
    ) : (
      <div class="thumb rounded-lg bg-border-light border border-border-warm shrink-0"></div>
    )}

    <span class="arrow text-base text-ink-faint shrink-0">↗</span>
  </div>
</a>

<style>
  .left-col {
    width: 160px;
    padding: 28px 24px;
  }
  .thumb {
    width: 120px;
    height: 84px;
  }
  .arrow {
    transition: transform 0.15s ease, color 0.15s ease;
  }
  .card-link:hover .arrow {
    transform: translate(3px, -3px);
    color: #1A1A16;
  }

  .fade-card {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .fade-card.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const cards = document.querySelectorAll('.card-link');
  cards.forEach((card) => card.classList.add('fade-card'));

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  cards.forEach((card) => observer.observe(card));
</script>
